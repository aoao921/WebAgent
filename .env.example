# Any OpenAI-compatible Chat Completions endpoint with tool calling.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Start the browser server separately with: cd browser && npm ci && npm start
WEBAGENT_MCP_URL=http://127.0.0.1:8931/mcp
WEBAGENT_DATA_DIR=var
# Browser server settings are process environment variables for npm start;
# the Node server does not load the Python .env file.
# MCP_HOST=127.0.0.1
# MCP_PORT=8931
# BROWSER_HEADLESS=1
# Optional system browser, otherwise use: npx playwright install chromium
# BROWSER_EXECUTABLE_PATH=
